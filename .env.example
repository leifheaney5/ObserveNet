# ObserveNet configuration. Copy to .env — or run `make init`, which generates the secrets
# below with random values. There are no default credentials: the stack refuses to start
# without a secret key, and no admin account is created without a 12+ character password.

# ---- required secrets (generated by `make init`) ---------------------------------------
POSTGRES_PASSWORD=
OBSERVENET_SECRET_KEY=
OBSERVENET_ADMIN_USERNAME=admin
OBSERVENET_ADMIN_PASSWORD=
# Token used by the bundled `collector` service. Revocable in Settings → Agent tokens.
OBSERVENET_BOOTSTRAP_AGENT_TOKEN=

# ---- what runs --------------------------------------------------------------------------
# collector          = read-only Linux collector on this host (default)
# tunnel             = Cloudflare Tunnel (needs CLOUDFLARE_TUNNEL_TOKEN)
# docker-inventory   = read-only Docker socket proxy for published-port inventory
# observability      = Prometheus + Jaeger for ObserveNet's own metrics/traces
# graph              = Neo4j projection of the observed topology
COMPOSE_PROFILES=collector
# true = synthetic, clearly labelled demo data. Real collectors are rejected while it is on,
# and all demo rows are purged the next time the stack starts with false.
OBSERVENET_DEMO_MODE=false

# ---- where the UI is reachable ----------------------------------------------------------
# Loopback only by default. Use a trusted LAN address (never 0.0.0.0 on an untrusted network).
OBSERVENET_BIND=127.0.0.1
OBSERVENET_PORT=8080
# The origin browsers use. With https:// the session cookies are marked Secure and HSTS is sent.
OBSERVENET_PUBLIC_URL=http://localhost:8080
# Host headers the API accepts (comma separated).
OBSERVENET_ALLOWED_HOSTS=localhost,127.0.0.1
# Production example for the public hostname:
# OBSERVENET_PUBLIC_URL=https://observenet.leafslab.com
# OBSERVENET_ALLOWED_HOSTS=observenet.leafslab.com,localhost,127.0.0.1

# ---- optional ---------------------------------------------------------------------------
# Name shown for this host's collector (defaults to the hostname).
OBSERVENET_AGENT_HOSTNAME=
# Cloudflare Tunnel token (profile `tunnel`). See docs/DOMAIN_AND_AUTH.md.
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARED_VERSION=2024.11.1
# Read-only Docker inventory (profile `docker-inventory`): http://127.0.0.1:2375
OBSERVENET_DOCKER_API_URL=
# Outbound alert webhook (off unless set). Signed with HMAC-SHA256 if a secret is given.
OBSERVENET_ALERT_WEBHOOK_URL=
OBSERVENET_ALERT_WEBHOOK_SECRET=
# OTLP/HTTP trace endpoint, e.g. http://jaeger:4318 with the `observability` profile.
OBSERVENET_OTEL_EXPORTER_OTLP_ENDPOINT=
# Neo4j projection (profile `graph`): set the URI to bolt://neo4j:7687 to enable it.
OBSERVENET_NEO4J_URI=
NEO4J_PASSWORD=
# Path (inside the backend containers) to the IEEE MA-L OUI CSV for MAC vendor lookup.
OBSERVENET_OUI_FILE=
OBSERVENET_LOG_LEVEL=INFO
